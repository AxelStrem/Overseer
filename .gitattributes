# Run inside a Linux container, where a carriage return ends up in the shebang.
docker/*.sh text eol=lf
scripts/*.sh text eol=lf
# A shebang that ends in a carriage return breaks a test's import of the script, and tests read
# the skills' text and compare the bundled copies with their sources byte for byte.
scripts/*.mjs text eol=lf
.claude/skills/** text eol=lf
overseer_syntax_specification.md text eol=lf
API.md text eol=lf
